# Copy to .env (git-ignored). Never commit a key.

# --- deployment (scripts/deploy.cjs) ---
# pays the gas of the deployment and gets no power over the feed
DEPLOYER_PRIVATE_KEY=
# the team's Safe on HyperEVM: names the reporters, sets the band
FEED_OWNER=0xA86c36f0031142BAafc173df2B91640F0F4f97e6
# reporter addresses, comma separated (one per reporter process)
REPORTERS=
# band around the HyperCore mid, in basis points (1000 = 10%), from 100 to 3000
MAX_DEVIATION_BPS=1000
# an observation older than this (seconds) when it reaches the chain is refused
MAX_OBSERVATION_AGE=300
# set to 1 to accept a Safe that asks one signature only (while its second signer is not added)
ALLOW_OWNER_THRESHOLD_1=
# source verification on hyperevmscan.io (an etherscan.io API key, v2 works for every chain)
ETHERSCAN_API_KEY=

# --- reporter (reporter/reporter.mjs) ---
# the deployed feed (deployments/hyperevm.json)
FEED_ADDRESS=
# a key of its own, with a little HYPE on HyperEVM for gas and nothing else
REPORTER_PRIVATE_KEY=
# HYPEREVM_RPC=https://rpc.hyperliquid.xyz/evm   (a paid one, e.g. Dwellir, only if the public one rate-limits)
# SAMPLE_SEC=30
# MIN_GAS_HYPE=0.01
